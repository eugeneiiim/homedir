## Control-h is the command key; Control-h h sends a literal Control-h

escape ^Hh

## do not trash BackSpace, usually DEL
bindkey -k kb
bindkey -d -k kb

## do not trash Delete, usually ESC [ 3 ~
bindkey -k kD
bindkey -d -k kD

termcapinfo xterm* ti@:te@

multiuser on

defutf8 on

## Claude Code picks 24-bit color from COLORTERM; keep it on 256 colors inside screen
unsetenv COLORTERM
